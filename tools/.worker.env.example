# Copy this file to  tools/.worker.env  and fill in your values.
# tools/.worker.env is git-ignored and must NEVER be committed or shared.

# Your deployed Worker URL (no trailing slash), e.g.
#   https://dahoom-activation.YOURNAME.workers.dev
WORKER_URL=

# The admin token you set with:  npx wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=

# The master payload key you set with:  npx wrangler secret put PAYLOAD_KEY
# The same value is used locally to encrypt menu.enc. Generate one with:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 44
PAYLOAD_KEY=
